# ==========================================
# PORTFOLIOMATE FULL-STACK CONFIGURATION
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# For local MongoDB: mongodb://127.0.0.1:27017/portfolio
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Security & Authentication
# Generate a random 64-character secret in production
JWT_SECRET=noor_portfolio_super_secure_production_jwt_secret_key_2026!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=noor_portfolio_cookie_session_secret_signing_key_2026!

# Initial Admin Seeding (Used if no admin user exists in the database)
ADMIN_EMAIL=admin@noor.dev
ADMIN_INITIAL_PASSWORD=AdminSecurePass2026!

# CORS Allowed Origin
# In development: http://localhost:3000
# In production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Client App URL
APP_URL=http://localhost:3000

# Optional Email Dispatch (Nodemailer for contact notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# NOTIFY_EMAIL=skmahammadnurhosen1@gmail.com
